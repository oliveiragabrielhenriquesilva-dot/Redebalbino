# GO Negocia — exemplo de configuração. Preencha segredos apenas no ambiente privado, nunca no GitHub.
# Variáveis com o prefixo anterior OLIVELO_* continuam aceitas como alias (docs/TRANSICAO-GO-NEGOCIA.md).
PORT=3101
HOST=127.0.0.1

# Pasta de dados própria da GO Negocia (banco, backups). NUNCA aponte para a pasta do Balbino Chat.
GO_NEGOCIA_RUNTIME_DIR=./runtime

# Cookie seguro: true em produção (HTTPS). Em desenvolvimento local, false.
COOKIE_SECURE=false

# Primeiro administrador: criado apenas se ainda não houver nenhum usuário. Senha obrigatória (mín. 10 caracteres).
GO_NEGOCIA_ADMIN_LOGIN=admin
GO_NEGOCIA_ADMIN_SENHA=

# Envio real de WhatsApp. Enquanto for diferente de 1, conexões no modo OFICIAL registram a mensagem
# sem chamar a API da Meta (status NAO_ENVIADA_ENVIO_DESLIGADO). Mantenha 0 até a operação real ser aprovada.
GO_NEGOCIA_ENVIO_REAL=0

# API oficial (WhatsApp Cloud API / Meta)
# Segredo do app Meta — usado para validar a assinatura X-Hub-Signature-256 do webhook.
META_APP_SECRET=
# Token de verificação do webhook (GET hub.verify_token).
GO_NEGOCIA_WEBHOOK_VERIFY_TOKEN=
# Os tokens de acesso de cada conexão ficam em variáveis próprias, referenciadas pelo cadastro da conexão.
# Ex.: conexão com "token_env" = META_TOKEN_ESCOLA_A  →  META_TOKEN_ESCOLA_A=EAAG...
